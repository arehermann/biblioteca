# Copia este archivo como .env y completa los valores.
ANTHROPIC_API_KEY=
# Clave de Google Books (gratis). Sin ella Google casi siempre responde "cuota excedida". Ver README.
GOOGLE_BOOKS_API_KEY=
# Cadena larga y aleatoria para firmar las sesiones (python3 -c "import secrets; print(secrets.token_hex(32))")
BIBLIOTECA_SECRET=
# Carpeta donde se guarda la base de datos y los respaldos
BIBLIOTECA_DATA=./data
